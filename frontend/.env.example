# ============================================================
# Frontend environment template — copy to `.env.local` (gitignored!)
# ============================================================

# ------------------------------------------------------------
# Browser-side API origin.
# Leave EMPTY in development: browser calls same-origin /api/*
# and next.config.ts rewrites proxy them to the .NET API
# (no CORS setup needed). Set a FULL origin (e.g.
# https://api.your-domain.com) in production deployments.
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------
# Server-side origin used ONLY by React Server Components
# (e.g. the Featured Courses section on the landing page).
# The Next.js server fetches the .NET API directly, so this must
# be reachable from the server process. We default to the HTTP
# Kestrel port because the HTTPS dev cert is self-signed and
# would fail server-side TLS validation.
# You can also override the dev-proxy target with API_PROXY_TARGET.
# ------------------------------------------------------------
SERVER_API_BASE_URL=http://localhost:5087

# ------------------------------------------------------------
# Canonical site URL used for absolute URLs, sitemap, and
# open-graph metadata (see app/layout.tsx).
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the dev proxy points (default shown).
# API_PROXY_TARGET=http://localhost:5087
