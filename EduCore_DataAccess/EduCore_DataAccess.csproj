<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 still resolves System.Security.Cryptography.Pkcs 9.0.18,
         which is affected by GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx.
         No SqlClient release currently pulls a patched 9.0.x, so pin the
         patched 10.0.x (compatible with net10.0) directly here. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

</Project>
