# Copy to EduCoreAPI/.env and fill in real values. .env is gitignored — never commit secrets.

# HS256 signing key for JWTs. Use a long random value (>= 64 chars recommended).
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# SQL Server connection string used by EduCore_DataAccess.
DB_CONNECTION=Server=.;Database=EduCore;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True

# Reserved (currently unused by the API).
API_KEY=REPLACE_WITH_API_KEY

# Reserved (currently unused; Kestrel URL is configured via launchSettings.json).
PORT=5001
