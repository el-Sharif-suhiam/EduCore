# Copy to EduCoreAPI/.env and fill in real values. .env is gitignored — never commit secrets.

# HS256 signing key for JWTs. REQUIRED — the API now fails fast at
# startup if missing or shorter than 32 bytes. Use a long random value
# (>= 48 bytes recommended). e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# JWT claims. Override only if you must; generation (AuthController) and
# validation (Program.cs) read the SAME values via EnvConfig.
# JWT_ISSUER=EduCoreApi
# JWT_AUDIENCE=EduCoreApiUsers

# Comma-separated list of allowed browser origins (CORS). Defaults to the
# two localhost origins used in development.
# CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com

# SQL Server connection string used by EduCore_DataAccess.
DB_CONNECTION=Server=.;Database=EduCore;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True

# ============================================================
# ====== PAYMENT GATEWAY: STRIPE — CHANGE HERE ===============
# ============================================================
# Get test keys at https://dashboard.stripe.com/test/apikeys
# Secret key (sk_test_...). Checkout fails with a clear 400 if missing.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...).
# Local development with the Stripe CLI:
#   stripe listen --forward-to localhost:5087/api/webhooks/stripe
#   → paste the whsec_... it prints here.
STRIPE_WEBHOOK_SECRET=

# Where the browser lands after Stripe hosted checkout.
# The backend appends /cart?checkout=success|cancelled&paymentId={id}
FRONTEND_URL=http://localhost:3000
# ============================================================

# Reserved (currently unused by the API).
API_KEY=REPLACE_WITH_API_KEY

# Reserved (currently unused; Kestrel URL is configured via launchSettings.json).
PORT=5001
